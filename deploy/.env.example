# Copy to deploy/.env and fill in real values. Never commit deploy/.env.

DOMAIN=gal.example.com

# MySQL
DB_NAME=gal
DB_USER=gal
DB_PASSWORD=change-me-db
DB_ROOT_PASSWORD=change-me-root

# Redis
REDIS_PASSWORD=change-me-redis

# SMTP: use a transactional mail provider in production (DirectMail, SES, Resend, ...)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Public URL and browser origin (must match the scheme + host users visit)
APP_BASE_URL=https://gal.example.com
APP_ALLOWED_ORIGINS=https://gal.example.com

# Only the nginx container may set X-Real-IP / X-Forwarded-For
APP_TRUSTED_PROXIES=172.28.0.10/32

# Promote this already-registered account to ADMIN on startup
APP_BOOTSTRAP_ADMIN_EMAIL=
